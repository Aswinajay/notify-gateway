# =====================================================================
# OpenWA - Environment Configuration for Render Free Tier (512 MB RAM)
# With Persistent Disk + R2 Durable Recovery Snapshots
# =====================================================================
# Persistent Disk must be mounted at /data for SQLite + session data.
# R2 provides compressed, versioned snapshots — NOT a live filesystem.
# =====================================================================

# Server & Runtime
NODE_ENV=production
NODE_OPTIONS=--max-old-space-size=256 --optimize-for-size
HOST=0.0.0.0
PORT=10000

# WhatsApp Engine
ENGINE_TYPE=baileys
SESSION_DATA_PATH=/data/sessions
AUTO_START_SESSIONS=true
PUPPETEER_SKIP_DOWNLOAD=true

# Bounded session startup (prevents resource storms)
AUTOSTART_THROTTLE_MS=3000
MAX_CONCURRENT_SESSIONS=1

# Send-only micro-optimizations
OUTBOUND_ONLY=true
LITE_MODE=true
BAILEYS_SYNC_HISTORY=false
BAILEYS_SYNC_FULL_HISTORY=false
MEDIA_DOWNLOAD_ENABLED=false
BAILEYS_MARK_ONLINE_ON_CONNECT=false
BAILEYS_MESSAGE_STORE_LIMIT=50
BAILEYS_SESSION_STORE_MAX_ENTRIES=100

# Database: absolute path on persistent disk
DATABASE_TYPE=sqlite
DATABASE_NAME=/data/openwa.sqlite
DATABASE_SYNCHRONIZE=false
DATABASE_LOGGING=false

# R2 Durable Recovery Snapshots
R2_SYNC_ENABLED=false
# R2_BUCKET=openwa-snapshots
# R2_ENDPOINT=https://<account-id>.r2.cloudflarestorage.com
# R2_ACCESS_KEY_ID=<set via Render secrets>
# R2_SECRET_ACCESS_KEY=<set via Render secrets>
# R2_PREFIX=openwa
R2_DEBOUNCE_MS=45000
R2_MAX_RETAINED=2
R2_RETRY_MAX=5
R2_RETRY_BASE_MS=2000

# Optional components (disabled for memory savings)
QUEUE_ENABLED=false
REDIS_ENABLED=false
CACHE_ENABLED=false
SEARCH_ENABLED=false
MCP_ENABLED=false

# Dashboard
SERVE_DASHBOARD=true
ENABLE_SWAGGER=false

# Storage
STORAGE_TYPE=local
STORAGE_LOCAL_PATH=/data/media
BODY_SIZE_LIMIT=15mb

# Security (set via Render dashboard or generateValue)
# API_MASTER_KEY=owa_k1_your_32_character_long_secret_key_here
